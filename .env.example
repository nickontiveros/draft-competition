# Random string participants' admin actions require (forms on /admin)
ADMIN_TOKEN=change-me

# Fernet key for encrypting Kalshi private keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_SECRET=

# SQLite file location
DB_PATH=tracker.db

# Minutes between automatic syncs
SYNC_INTERVAL_MINUTES=5

# Public Polygon RPC used to read USDC cash balances (no key needed)
POLYGON_RPC_URL=https://polygon-rpc.com

# Set to 1 to run with fixture-backed mock connectors (local demo)
MOCK_CONNECTORS=0
